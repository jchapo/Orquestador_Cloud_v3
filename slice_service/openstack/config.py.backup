import os
import json

class OpenStackConfig:
    def __init__(self):
        self.config = {
            'auth_url': 'http://localhost:15000/v3',
            'username': 'admin',
            'password': 'admin123',
            'project_name': 'admin',
            'user_domain_name': 'Default',
            'project_domain_name': 'Default',
            'region_name': 'RegionOne',
            'nova_endpoint': 'http://localhost:18774/v2.1',
            'neutron_endpoint': 'http://localhost:19696',
            'glance_endpoint': 'http://localhost:19292',
            'flavors': {
                'small': {'vcpus': 1, 'ram': 512, 'disk': 10},
                'medium': {'vcpus': 2, 'ram': 1024, 'disk': 20}
