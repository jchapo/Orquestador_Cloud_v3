#!/usr/bin/env python3
"""
PUCP Cloud Orchestrator - Test Case 2.2.1
Caso 2.2.1 - Algoritmo balanced placement
Objetivo: Verificar funcionamiento del algoritmo de placement balanceado
"""
import requests
import json
import time
import sys
import os
import math
from datetime import datetime
from typing import Dict, Optional, List

# Configuración
API_BASE = "http://localhost/api"
TEST_USERNAME = "testuser"
TEST_PASSWORD = "testpass123"

class TestCase221:
    def __init__(self):
        self.token = None
        self.slice_id = None
        self.session = requests.Session()
        self.test_results = {
            "case_number": "2.2.1",
            "objective": "Verificar funcionamiento del algoritmo de placement balanceado",
            "start_time": None,
            "end_time": None,
            "status": "PENDING",
            "steps": [],
            "evidences": [],
            "placement_analysis": {}
        }
        
    def log_step(self, step_number: int, description: str, status: str, details: Dict = None):
        """Registrar paso del test"""
        step = {
            "step": step_number,
            "description": description,
            "status": status,
            "timestamp": datetime.now().isoformat(),
            "details": details or {}
        }
        self.test_results["steps"].append(step)
        print(f"📋 Paso {step_number}: {description} - {status}")
        if details:
            for key, value in details.items():
                print(f"   {key}: {value}")
    
    def add_evidence(self, evidence_type: str, content: Dict):
        """Agregar evidencia del test"""
        evidence = {
            "type": evidence_type,
            "timestamp": datetime.now().isoformat(),
            "content": content
        }
        self.test_results["evidences"].append(evidence)
        
    def check_prerequisites(self) -> bool:
        """Verificar prerrequisitos del test"""
        print("🔍 VERIFICANDO PRERREQUISITOS")
        print("-" * 40)
        
        prerequisites_ok = True
        
        # Prerrequisito 1: Usuario autenticado
        print("1. Verificando autenticación...")
        if self.authenticate():
            self.log_step(0, "Prerrequisito: Autenticación", "PASS", 
                          {"username": TEST_USERNAME, "token_received": bool(self.token)})
        else:
            self.log_step(0, "Prerrequisito: Autenticación", "FAIL")
            prerequisites_ok = False
        
        # Prerrequisito 2: Base de datos inicializada
        print("2. Verificando base de datos...")
        try:
            response = self.session.get(f"{API_BASE}/../health")
            if response.status_code == 200:
                health_data = response.json()
                self.log_step(0, "Prerrequisito: Base de datos", "PASS", 
                              {"health_status": health_data})
                self.add_evidence("health_check", health_data)
            else:
                self.log_step(0, "Prerrequisito: Base de datos", "FAIL", 
                              {"error": response.text})
                prerequisites_ok = False
        except Exception as e:
            self.log_step(0, "Prerrequisito: Base de datos", "FAIL", 
                          {"error": str(e)})
            prerequisites_ok = False
        
        # Prerrequisito 3: Al menos 3 servidores disponibles para balanceo
        print("3. Verificando servidores disponibles...")
        try:
            response = self.session.get(f"{API_BASE}/resources?infrastructure=linux")
            if response.status_code == 200:
                resources = response.json()
                servers = resources.get('servers', [])
                if len(servers) >= 3:
                    self.log_step(0, "Prerrequisito: Servidores para balanceo", "PASS", 
                                  {"servers_count": len(servers), "servers": [s['hostname'] for s in servers]})
                    self.add_evidence("available_resources", resources)
                    
                    # Verificar capacidad suficiente
                    total_available_vcpus = sum(s.get('available_vcpus', 0) for s in servers)
                    total_available_ram = sum(s.get('available_ram', 0) for s in servers)
                    
                    print(f"   Total vCPUs disponibles: {total_available_vcpus}")
                    print(f"   Total RAM disponible: {total_available_ram} MB")
                    
                    # Para 4 VMs necesitamos al menos: 2+4+2+4 = 12 vCPUs y 2048+4096+2048+4096 = 12288 MB RAM
                    required_vcpus = 12
                    required_ram = 12288
                    
                    if total_available_vcpus >= required_vcpus and total_available_ram >= required_ram:
                        self.log_step(0, "Prerrequisito: Capacidad suficiente", "PASS", 
                                      {"required_vcpus": required_vcpus, "available_vcpus": total_available_vcpus,
                                       "required_ram": required_ram, "available_ram": total_available_ram})
                    else:
                        self.log_step(0, "Prerrequisito: Capacidad suficiente", "FAIL", 
                                      {"error": f"Capacidad insuficiente. Requerido: {required_vcpus} vCPUs, {required_ram} MB RAM"})
                        prerequisites_ok = False
                else:
                    self.log_step(0, "Prerrequisito: Servidores para balanceo", "FAIL", 
                                  {"error": f"Se requieren al menos 3 servidores para balanceo, pero solo hay {len(servers)} disponibles"})
                    prerequisites_ok = False
            else:
                self.log_step(0, "Prerrequisito: Servidores para balanceo", "FAIL", 
                              {"error": response.text})
                prerequisites_ok = False
        except Exception as e:
            self.log_step(0, "Prerrequisito: Servidores para balanceo", "FAIL", 
                          {"error": str(e)})
            prerequisites_ok = False
        
        return prerequisites_ok
        
    def authenticate(self) -> bool:
        """Autenticar con el sistema"""
        login_data = {
            "username": TEST_USERNAME,
            "password": TEST_PASSWORD
        }
        
        try:
            response = self.session.post(f"{API_BASE}/auth/login", json=login_data)
            if response.status_code == 200:
                data = response.json()
                self.token = data.get('token')
                self.session.headers.update({'Authorization': f'Bearer {self.token}'})
                self.add_evidence("authentication", {"request": login_data, "response": data})
                return True
            else:
                self.add_evidence("authentication_error", {"request": login_data, "response": response.text})
                return False
                
        except Exception as e:
            self.add_evidence("authentication_error", {"request": login_data, "error": str(e)})
            return False
    
    def create_multi_vm_slice(self) -> bool:
        """Crear slice con 4 VMs de diferentes tamaños"""
        print("\n🏗️ CREANDO SLICE CON 4 VMs DE DIFERENTES TAMAÑOS")
        print("-" * 40)
        
        # Slice con VMs de diferentes tamaños para probar balanceo
        slice_payload = {
            "name": f"test-balanced-placement-{int(time.time())}",
            "description": "Test de algoritmo balanced placement con 4 VMs variadas",
            "infrastructure": "linux",
            "placement_policy": "balanced",  # ¡Especificamos placement balanceado!
            "nodes": [
                {
                    "name": "vm-small-1",
                    "image": "ubuntu-20.04",
                    "flavor": "small"  # 2 vCPUs, 2048 MB RAM
                },
                {
                    "name": "vm-medium-1",
                    "image": "ubuntu-20.04", 
                    "flavor": "medium"  # 4 vCPUs, 4096 MB RAM
                },
                {
                    "name": "vm-small-2",
                    "image": "ubuntu-20.04",
                    "flavor": "small"  # 2 vCPUs, 2048 MB RAM
                },
                {
                    "name": "vm-medium-2",
                    "image": "ubuntu-20.04",
                    "flavor": "medium"  # 4 vCPUs, 4096 MB RAM
                }
            ],
            "networks": [
                {
                    "name": "balanced-net",
                    "cidr": "192.168.200.0/24",
                    "gateway": "192.168.200.1"
                }
            ]
        }
        
        print("1. Enviando POST /slices con 4 VMs de diferentes tamaños...")
        try:
            response = self.session.post(f"{API_BASE}/slices", json=slice_payload)
            
            self.add_evidence("slice_creation_request", {
                "url": f"{API_BASE}/slices",
                "method": "POST",
                "payload": slice_payload,
                "response_status": response.status_code,
                "response_body": response.text
            })
            
            if response.status_code == 201:
                self.log_step(1, "POST /slices con placement_policy='balanced'", "PASS", 
                              {"status_code": response.status_code})
                
                response_data = response.json()
                slice_id = response_data.get('id')
                
                if slice_id:
                    self.slice_id = slice_id
                    self.log_step(2, "Validar slice_id generado", "PASS", 
                                  {"slice_id": slice_id})
                    
                    # Verificar que placement_policy fue registrado
                    placement_policy = response_data.get('placement_policy')
                    if placement_policy == 'balanced':
                        self.log_step(3, "Verificar placement_policy='balanced'", "PASS", 
                                      {"expected": "balanced", "actual": placement_policy})
                    else:
                        self.log_step(3, "Verificar placement_policy='balanced'", "FAIL", 
                                      {"expected": "balanced", "actual": placement_policy})
                        return False
                    
                    self.add_evidence("slice_creation_response", response_data)
                    return True
                else:
                    self.log_step(2, "Validar slice_id generado", "FAIL", 
                                  {"response": response_data})
                    return False
            else:
                self.log_step(1, "POST /slices", "FAIL", 
                              {"status_code": response.status_code, "response": response.text})
                return False
                
        except Exception as e:
            self.log_step(1, "POST /slices", "FAIL", {"error": str(e)})
            return False
    
    def deploy_with_balanced_placement(self) -> bool:
        """Ejecutar deployment con algoritmo balanced"""
        print("\n🚀 EJECUTANDO DEPLOYMENT CON BALANCED PLACEMENT")
        print("-" * 40)
        
        if not self.slice_id:
            print("❌ No hay slice_id para desplegar")
            return False
        
        print(f"2. Enviando POST /slices/{self.slice_id}/deploy...")
        try:
            # Capturar estado antes del deployment
            pre_deploy_response = self.session.get(f"{API_BASE}/resources?infrastructure=linux")
            if pre_deploy_response.status_code == 200:
                pre_deploy_resources = pre_deploy_response.json()
                self.add_evidence("pre_deployment_resources", pre_deploy_resources)
            
            # Ejecutar deployment
            deploy_data = {
                "placement_policy": "balanced"  # Confirmar policy en deployment
            }
            
            response = self.session.post(f"{API_BASE}/slices/{self.slice_id}/deploy", json=deploy_data)
            
            self.add_evidence("deployment_request", {
                "url": f"{API_BASE}/slices/{self.slice_id}/deploy",
                "method": "POST",
                "payload": deploy_data,
                "response_status": response.status_code,
                "response_body": response.text
            })
            
            if response.status_code == 200:
                self.log_step(4, "POST /slices/{id}/deploy con balanced", "PASS", 
                              {"status_code": response.status_code})
                
                response_data = response.json()
                deployment_result = response_data.get('deployment_result', {})
                
                if deployment_result:
                    deployed_vms = deployment_result.get('deployed_vms', [])
                    self.log_step(5, "Verificar VMs desplegadas", "PASS", 
                                  {"vms_count": len(deployed_vms), "vms": [vm['name'] for vm in deployed_vms]})
                    
                    self.add_evidence("deployment_response", response_data)
                    return True
                else:
                    self.log_step(5, "Verificar deployment_result", "FAIL", 
                                  {"response": response_data})
                    return False
            else:
                self.log_step(4, "POST /slices/{id}/deploy", "FAIL", 
                              {"status_code": response.status_code, "response": response.text})
                return False
                
        except Exception as e:
            self.log_step(4, "POST /slices/{id}/deploy", "FAIL", {"error": str(e)})
            return False
    
    def wait_for_deployment_completion(self, timeout: int = 300) -> bool:
        """Esperar a que el deployment se complete"""
        print("\n⏱️ ESPERANDO COMPLETACIÓN DEL DEPLOYMENT")
        print("-" * 40)
        
        start_time = time.time()
        last_status = None
        
        while time.time() - start_time < timeout:
            try:
                response = self.session.get(f"{API_BASE}/slices/{self.slice_id}")
                
                if response.status_code == 200:
                    slice_data = response.json()
                    current_status = slice_data.get('status')
                    
                    if current_status != last_status:
                        print(f"   Status actual: {current_status}")
                        last_status = current_status
                    
                    if current_status == 'active':
                        self.log_step(6, "Deployment completado", "PASS", 
                                      {"final_status": current_status, "duration": f"{time.time() - start_time:.1f}s"})
                        return True
                    elif current_status == 'error':
                        error_msg = slice_data.get('error_message', 'Unknown error')
                        self.log_step(6, "Deployment completado", "FAIL", 
                                      {"final_status": current_status, "error": error_msg})
                        return False
                
                time.sleep(10)
                
            except Exception as e:
                print(f"❌ Error monitoreando deployment: {e}")
                time.sleep(5)
        
        self.log_step(6, "Deployment completado", "FAIL", 
                      {"error": f"Timeout después de {timeout} segundos"})
        return False
    
    def analyze_vm_distribution(self) -> bool:
        """Analizar distribución de VMs entre servidores"""
        print("\n📊 ANALIZANDO DISTRIBUCIÓN DE VMs")
        print("-" * 40)
        
        try:
            # Obtener información del slice desplegado
            slice_response = self.session.get(f"{API_BASE}/slices/{self.slice_id}")
            if slice_response.status_code != 200:
                self.log_step(7, "Obtener info del slice", "FAIL", 
                              {"error": slice_response.text})
                return False
            
            slice_data = slice_response.json()
            nodes = slice_data.get('nodes', [])
            
            # Obtener recursos actuales de servidores
            resources_response = self.session.get(f"{API_BASE}/resources?infrastructure=linux")
            if resources_response.status_code != 200:
                self.log_step(7, "Obtener recursos de servidores", "FAIL", 
                              {"error": resources_response.text})
                return False
            
            resources_data = resources_response.json()
            servers = resources_data.get('servers', [])
            
            # Analizar distribución
            distribution = {}
            server_utilization = {}
            
            print("3. Analizando distribución de VMs por servidor...")
            
            for node in nodes:
                server = node.get('server', 'unknown')
                if server not in distribution:
                    distribution[server] = []
                distribution[server].append({
                    'name': node['name'],
                    'flavor': node.get('flavor', 'unknown'),
                    'vcpus': node.get('vcpus', 0),
                    'ram': node.get('ram', 0)
                })
            
            # Calcular utilización por servidor
            for server_info in servers:
                hostname = server_info['hostname']
                total_vcpus = server_info.get('total_vcpus', 0)
                total_ram = server_info.get('total_ram', 0)
                available_vcpus = server_info.get('available_vcpus', 0)
                available_ram = server_info.get('available_ram', 0)
                
                used_vcpus = total_vcpus - available_vcpus
                used_ram = total_ram - available_ram
                
                vcpu_utilization = (used_vcpus / total_vcpus * 100) if total_vcpus > 0 else 0
                ram_utilization = (used_ram / total_ram * 100) if total_ram > 0 else 0
                
                server_utilization[hostname] = {
                    'vcpu_utilization': vcpu_utilization,
                    'ram_utilization': ram_utilization,
                    'max_utilization': max(vcpu_utilization, ram_utilization),
                    'used_vcpus': used_vcpus,
                    'used_ram': used_ram,
                    'total_vcpus': total_vcpus,
                    'total_ram': total_ram
                }
            
            # Mostrar distribución
            print("📋 Distribución de VMs:")
            for server, vms in distribution.items():
                print(f"   {server}: {len(vms)} VMs")
                for vm in vms:
                    print(f"      • {vm['name']} ({vm['flavor']}: {vm['vcpus']} vCPUs, {vm['ram']} MB)")
            
            print("\n📊 Utilización de servidores:")
            for server, util in server_utilization.items():
                print(f"   {server}:")
                print(f"      CPU: {util['vcpu_utilization']:.1f}% ({util['used_vcpus']}/{util['total_vcpus']} vCPUs)")
                print(f"      RAM: {util['ram_utilization']:.1f}% ({util['used_ram']}/{util['total_ram']} MB)")
                print(f"      Max: {util['max_utilization']:.1f}%")
            
            # Guardar análisis
            self.test_results["placement_analysis"] = {
                "distribution": distribution,
                "server_utilization": server_utilization,
                "total_servers_used": len(distribution),
                "total_vms": len(nodes)
            }
            
            self.add_evidence("placement_analysis", self.test_results["placement_analysis"])
            
            self.log_step(7, "Analizar distribución de VMs", "PASS", 
                          {"servers_used": len(distribution), "total_vms": len(nodes)})
            
            return True
            
        except Exception as e:
            self.log_step(7, "Analizar distribución de VMs", "FAIL", {"error": str(e)})
            return False
    
    def verify_balanced_distribution(self) -> bool:
        """Verificar que las VMs se distribuyeron uniformemente"""
        print("\n✅ VERIFICANDO DISTRIBUCIÓN BALANCEADA")
        print("-" * 40)
        
        analysis = self.test_results["placement_analysis"]
        distribution = analysis.get("distribution", {})
        server_utilization = analysis.get("server_utilization", {})
        
        # Criterio 1: VMs distribuidas entre múltiples servidores
        servers_used = len(distribution)
        total_vms = analysis.get("total_vms", 0)
        
        print("4. Verificando distribución uniforme...")
        
        if servers_used >= 2:  # Al menos 2 servidores deben usarse para 4 VMs
            self.log_step(8, "VMs distribuidas entre múltiples servidores", "PASS", 
                          {"servers_used": servers_used, "total_vms": total_vms})
        else:
            self.log_step(8, "VMs distribuidas entre múltiples servidores", "FAIL", 
                          {"servers_used": servers_used, "total_vms": total_vms, 
                           "error": "Todas las VMs están en el mismo servidor"})
            return False
        
        # Criterio 2: Ningún servidor supera 80% de utilización
        print("5. Verificando límite de utilización (80%)...")
        max_utilization_violations = []
        
        for server, util in server_utilization.items():
            max_util = util['max_utilization']
            if max_util > 80.0:
                max_utilization_violations.append({
                    'server': server,
                    'utilization': max_util
                })
        
        if not max_utilization_violations:
            self.log_step(9, "Ningún servidor supera 80% utilización", "PASS", 
                          {"max_utilizations": {s: f"{u['max_utilization']:.1f}%" for s, u in server_utilization.items()}})
        else:
            self.log_step(9, "Ningún servidor supera 80% utilización", "FAIL", 
                          {"violations": max_utilization_violations})
            return False
        
        # Criterio 3: Distribución relativamente balanceada
        print("6. Verificando balance de carga...")
        vm_counts_per_server = [len(vms) for vms in distribution.values()]
        min_vms = min(vm_counts_per_server)
        max_vms = max(vm_counts_per_server)
        
        # Para ser balanceado, la diferencia no debería ser mayor a 2 VMs
        balance_acceptable = (max_vms - min_vms) <= 2
        
        if balance_acceptable:
            self.log_step(10, "Distribución balanceada de VMs", "PASS", 
                          {"vm_distribution": {server: len(vms) for server, vms in distribution.items()},
                           "min_vms_per_server": min_vms, "max_vms_per_server": max_vms})
        else:
            self.log_step(10, "Distribución balanceada de VMs", "FAIL", 
                          {"vm_distribution": {server: len(vms) for server, vms in distribution.items()},
                           "min_vms_per_server": min_vms, "max_vms_per_server": max_vms,
                           "error": f"Diferencia de {max_vms - min_vms} VMs es demasiado alta"})
            return False
        
        # Criterio 4: Diferentes tipos de VMs bien distribuidos
        print("7. Verificando distribución de tipos de VM...")
        flavor_distribution = {}
        
        for server, vms in distribution.items():
            flavor_distribution[server] = {}
            for vm in vms:
                flavor = vm['flavor']
                if flavor not in flavor_distribution[server]:
                    flavor_distribution[server][flavor] = 0
                flavor_distribution[server][flavor] += 1
        
        # Verificar que no todos los medium estén en un solo servidor
        medium_servers = []
        small_servers = []
        
        for server, flavors in flavor_distribution.items():
            if flavors.get('medium', 0) > 0:
                medium_servers.append(server)
            if flavors.get('small', 0) > 0:
                small_servers.append(server)
        
        if len(medium_servers) >= 1 and len(small_servers) >= 1:
            self.log_step(11, "Distribución balanceada por tipo de VM", "PASS", 
                          {"flavor_distribution": flavor_distribution,
                           "medium_on_servers": medium_servers, "small_on_servers": small_servers})
        else:
            self.log_step(11, "Distribución balanceada por tipo de VM", "WARN", 
                          {"flavor_distribution": flavor_distribution,
                           "note": "Tipos de VM podrían estar mejor distribuidos"})
        
        self.add_evidence("balance_verification", {
            "servers_used": servers_used,
            "utilization_violations": max_utilization_violations,
            "vm_distribution": vm_counts_per_server,
            "flavor_distribution": flavor_distribution
        })
        
        print("✅ Verificación de balanceo completada exitosamente")
        return True
    
    def generate_placement_report(self):
        """Generar reporte detallado del placement"""
        print("\n📋 REPORTE DE PLACEMENT BALANCEADO")
        print("=" * 50)
        
        analysis = self.test_results["placement_analysis"]
        
        print(f"Slice ID: {self.slice_id}")
        print(f"Política de placement: balanced")
        print(f"Total de VMs: {analysis.get('total_vms', 0)}")
        print(f"Servidores utilizados: {analysis.get('total_servers_used', 0)}")
        
        print("\n📊 DISTRIBUCIÓN FINAL:")
        distribution = analysis.get("distribution", {})
        for server, vms in distribution.items():
            print(f"\n🖥️ {server}:")
            for vm in vms:
                print(f"   • {vm['name']} ({vm['flavor']}: {vm['vcpus']} vCPUs, {vm['ram']} MB)")
        
        print("\n⚡ UTILIZACIÓN DE SERVIDORES:")
        server_utilization = analysis.get("server_utilization", {})
        for server, util in server_utilization.items():
            status = "✅" if util['max_utilization'] <= 80 else "⚠️"
            print(f"{status} {server}: {util['max_utilization']:.1f}% máximo")
            print(f"     CPU: {util['vcpu_utilization']:.1f}% | RAM: {util['ram_utilization']:.1f}%")
    
    def cleanup_test_slice(self):
        """Limpiar el slice de prueba"""
        if not self.slice_id:
            return
        
        print(f"\n🧹 Limpiando slice de prueba {self.slice_id}...")
        
        try:
            response = self.session.delete(f"{API_BASE}/slices/{self.slice_id}")
            if response.status_code == 200:
                print("✅ Slice eliminado correctamente")
            else:
                print(f"⚠️ Error eliminando slice: {response.text}")
        except Exception as e:
            print(f"⚠️ Error en cleanup: {e}")
    
    def save_test_results(self):
        """Guardar resultados del test en archivo"""
        filename = f"test_case_2_2_1_results_{int(time.time())}.json"
        try:
            with open(filename, 'w') as f:
                json.dump(self.test_results, f, indent=2)
            print(f"\n💾 Resultados guardados en: {filename}")
        except Exception as e:
            print(f"❌ Error guardando resultados: {e}")
    
    def generate_test_report(self):
        """Generar reporte final del test"""
        print("\n📊 REPORTE DEL TEST CASO 2.2.1")
        print("=" * 50)
        
        passed_steps = len([s for s in self.test_results["steps"] if s["status"] == "PASS"])
        total_steps = len(self.test_results["steps"])
        
        print(f"Caso de prueba: {self.test_results['case_number']}")
        print(f"Objetivo: {self.test_results['objective']}")
        print(f"Estado final: {self.test_results['status']}")
        print(f"Pasos ejecutados: {total_steps}")
        print(f"Pasos exitosos: {passed_steps}")
        print(f"Duración: {self.test_results['start_time']} - {self.test_results['end_time']}")
        
        print("\nRESUMEN DE PASOS:")
        for step in self.test_results["steps"]:
            status_icon = "✅" if step["status"] == "PASS" else "❌" if step["status"] == "FAIL" else "⚠️"
            print(f"{status_icon} Paso {step['step']}: {step['description']}")
        
        self.generate_placement_report()
        
        print(f"\n📁 EVIDENCIAS RECOLECTADAS: {len(self.test_results['evidences'])}")
        for i, evidence in enumerate(self.test_results["evidences"], 1):
            print(f"{i}. {evidence['type']} - {evidence['timestamp']}")
    
    def run_test(self):
        """Ejecutar test completo del Caso 2.2.1"""
        print("🧪 PUCP CLOUD ORCHESTRATOR - TEST CASE 2.1")
        print("Algoritmo balanced placement")
        print("=" * 60)
       
        self.test_results["start_time"] = datetime.now().isoformat()
       
	       try:
	           # Verificar prerrequisitos
	           if not self.check_prerequisites():
               self.test_results["status"] = "FAILED_PREREQUISITES"
               return False
           
           # Paso 1: Crear slice con 4 VMs de diferentes tamaños
           if not self.create_multi_vm_slice():
               self.test_results["status"] = "FAILED_SLICE_CREATION"
               return False
           
           # Paso 2: Ejecutar deployment con placement balanceado
           if not self.deploy_with_balanced_placement():
               self.test_results["status"] = "FAILED_DEPLOYMENT"
               return False
           
           # Paso 3: Esperar completación del deployment
           if not self.wait_for_deployment_completion():
               self.test_results["status"] = "FAILED_DEPLOYMENT_TIMEOUT"
               return False
           
           # Paso 4: Analizar distribución de VMs
           if not self.analyze_vm_distribution():
               self.test_results["status"] = "FAILED_ANALYSIS"
               return False
           
           # Paso 5: Verificar que la distribución es balanceada
           if not self.verify_balanced_distribution():
               self.test_results["status"] = "FAILED_BALANCE_VERIFICATION"
               return False
           
           self.test_results["status"] = "PASSED"
           
           print("\n🎉 ¡TEST CASO 2.2.1 EXITOSO!")
           print("✅ Algoritmo balanced placement funcionando correctamente")
           print("✅ VMs distribuidas uniformemente entre servidores")
           print("✅ Ningún servidor supera 80% de utilización")
           print("✅ Distribución balanceada verificada")
           
           return True
           
       except KeyboardInterrupt:
           print("\n⚠️ Test interrumpido por el usuario")
           self.test_results["status"] = "INTERRUPTED"
           return False
       except Exception as e:
           print(f"\n💥 Error crítico en test: {e}")
           self.test_results["status"] = "ERROR"
           return False
       finally:
           self.test_results["end_time"] = datetime.now().isoformat()
           self.generate_test_report()
           self.save_test_results()
           
           # Preguntar si limpiar
           if self.slice_id:
               cleanup = input(f"\n¿Deseas eliminar el slice de prueba {self.slice_id}? (y/n): ")
               if cleanup.lower() == 'y':
                   self.cleanup_test_slice()
               else:
                   print(f"💡 Slice conservado: {self.slice_id}")
                   print(f"   Para eliminarlo: curl -X DELETE {API_BASE}/slices/{self.slice_id} -H 'Authorization: Bearer {self.token}'")

def main():
   """Función principal"""
   test = TestCase221()
   success = test.run_test()
   
   if success:
       print("\n✅ Test Case 2.2.1 completado exitosamente!")
       sys.exit(0)
   else:
       print("\n❌ Test Case 2.2.1 falló")
       sys.exit(1)

if __name__ == '__main__':
   main()
